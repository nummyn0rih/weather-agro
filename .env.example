# ==============================================
# Weather Agro — Environment Variables
# ==============================================
# Скопируйте этот файл в .env и заполните значения.
# НЕ коммитьте .env в git!

# ==============================================
# Database (PostgreSQL + TimescaleDB)
# ==============================================
POSTGRES_USER=weather
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=weather
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://weather:changeme_strong_password@db:5432/weather

# ==============================================
# Backend (FastAPI)
# ==============================================
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=replace_with_random_64_char_hex_string

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS (в production — ваш домен)
CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# Окружение
ENVIRONMENT=development
# development | production
LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR

# ==============================================
# Admin user (создаётся при первом запуске)
# ==============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_admin_password

# ==============================================
# Внешние API
# ==============================================
# Open-Meteo — без ключа, бесплатно
# NASA POWER — без ключа, бесплатно

# OpenWeatherMap (опционально, для текущей погоды)
# Получить: https://openweathermap.org/api (бесплатный тариф)
OPENWEATHERMAP_API_KEY=

# ==============================================
# Telegram Bot
# ==============================================
# Создать бота через @BotFather, получить токен
TELEGRAM_BOT_TOKEN=
# TTL одноразового кода привязки chat_id (секунды)
TELEGRAM_BIND_CODE_TTL=300

# ==============================================
# Yandex.Disk (WebDAV) — для бэкапов
# ==============================================
# Войти: https://passport.yandex.ru/profile → "Пароли приложений"
# Создать пароль для WebDAV
YANDEX_DISK_LOGIN=
YANDEX_DISK_APP_PASSWORD=
YANDEX_DISK_BACKUP_PATH=/weather-app-backups/

# Настройки ротации бэкапов
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_MONTHLY=12

# ==============================================
# Шифрование чувствительных данных в БД
# ==============================================
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace_with_fernet_key

# ==============================================
# Frontend (Vite)
# ==============================================
# В development:
VITE_API_URL=http://localhost:8000/api

# В production раскомментируйте:
# VITE_API_URL=https://your-domain.com/api

# ==============================================
# Nginx / HTTPS (только для production)
# ==============================================
DOMAIN=your-domain.com
# Email для Let's Encrypt
LETSENCRYPT_EMAIL=your-email@example.com

# ==============================================
# Загрузка файлов
# ==============================================
UPLOAD_DIR=/uploads
MAX_UPLOAD_SIZE_MB=10
MAX_PHOTOS_PER_EVENT=5

# ==============================================
# Расписания (опционально, переопределение по умолчанию)
# ==============================================
# Cron-выражения в формате APScheduler
# По умолчанию используются значения из app/scheduler/jobs.py
# DAILY_FETCH_CRON=0 3 * * *
# FORECAST_FETCH_CRON=0 6,18 * * *
# ALERTS_CHECK_CRON=0 * * * *
# BACKUP_CRON=0 4 * * *